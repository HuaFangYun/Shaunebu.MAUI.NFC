<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net11.0-android;net11.0-ios</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <NoWarn>CA1416,CA1422,CA1859;CS0067</NoWarn>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">25.0</SupportedOSPlatformVersion>

    <!-- NuGet -->
    <Authors>Shaunebu</Authors>
    <Copyright>Copyright © Shaunebu</Copyright>
    <IsPackable>True</IsPackable>
    <PackageProjectUrl>https://github.com/Shaunebu/Shaunebu.MAUI.NFC</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Shaunebu/Shaunebu.MAUI.NFC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet-maui;maui;nfc;ndef;android;ios;core-nfc;mobile;near-field-communication</PackageTags>
    <IncludeSymbols>True</IncludeSymbols>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Title>NFC Plugin for .NET Maui</Title>
    <Description>A focused .NET MAUI NFC plugin for reading, writing, clearing, and optionally locking NDEF tags on Android and iOS.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <DebugType>portable</DebugType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>1.1.1 focuses on production readiness: .NET 9, .NET 10, and .NET 11 MAUI Android/iOS package validation, API compatibility against 1.0.4, NDEF text/URI/MIME/external correctness fixes, Android/iOS reliability hardening, additive capability reporting, configurable event dispatch, redacted diagnostics, tag technology metadata, raw NDEF type/id metadata on reads, expanded tests, richer README documentation, and polished NuGet metadata.</PackageReleaseNotes>
    <Version>1.1.1</Version>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="all" />

    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"
                      Version="10.0.10"
                      Condition="$(TargetFramework.StartsWith('net10.0'))" />

    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"
                      Version="11.0.0"
                      Condition="$(TargetFramework.StartsWith('net11.0'))" />

    <PackageReference Include="Microsoft.Maui.Controls"
                      Version="10.0.130"
                      Condition="$(TargetFramework.StartsWith('net10.0'))" />

    <PackageReference Include="Microsoft.Maui.Controls"
                      Version="11.0.10"
                      Condition="$(TargetFramework.StartsWith('net11.0'))" />
  </ItemGroup>
  
  <!-- Package additions -->
  <ItemGroup>
    <None Include="..\..\art\nfc128.png" PackagePath="icon.png" Visible="false" Pack="true" />
    <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="\" />
  </ItemGroup>

</Project>
